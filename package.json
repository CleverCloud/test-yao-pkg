{
  "name": "clever-test-yao-pkg",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "bundle-cjs": "rollup -c rollup.config.js",
    "build:linux": "pkg -t node22-linux-x64 build/clever.cjs -o build/clever",
    "build:mac": "pkg -t node22-mac-arm64 build/clever.cjs -o build/clever",
    "build:windows": "pkg -t node22-win-x64 build/clever.cjs -o build/clever.exe",
    "preview:publish": "node src"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@yao-pkg/pkg": "^6.5.1",
    "magic-string": "^0.30.17",
    "rollup": "^4.44.2"
  },
  "volta": {
    "node": "22.17.0"
  },
  "dependencies": {
    "text-table": "^0.2.0"
  }
}
